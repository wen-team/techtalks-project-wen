msgstr "تم إنشاء بطاقة العنوان"

msgid "Private link created"
msgstr "تم إنشاء رابط خاص"

msgid "Link opened"
msgstr "تم فتح الرابط"

msgid "Driver confirmed the landmark"
msgstr "أكّد السائق المعلم"

